{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "klirr-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "klirr-desktop-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev:desktop"],
      "port": 5174
    },
    {
      "name": "klirr-web-cloudflare",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "wrangler@4.168.0", "dev", "--config", "web/wrangler.jsonc", "--port", "8787"],
      "port": 8787
    }
  ]
}
